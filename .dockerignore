# Keep the build context lean and keep local-only / rebuilt artifacts out of the image.
.git
.github
.venv
**/node_modules
frontend/dist          # rebuilt in the `web` stage
data/*.db              # local SQLite is disposable-by-design; prod uses VJA_DATABASE_URL (Neon)
**/__pycache__
.pytest_cache
.mypy_cache
.ruff_cache
tests
docs
deploy
.env
.env.*
!.env.example
*.tsbuildinfo
.DS_Store
