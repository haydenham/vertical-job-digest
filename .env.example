# Copy to .env (git-ignored) and fill in. Loaded automatically by the app (python-dotenv);
# launchd does not read your shell, so .env is the single source of runtime config.

# Resend (transactional email) — required to send digests + failure alerts.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Digest recipient. With the sandbox sender below this MUST be your Resend account email.
VJA_DIGEST_RECIPIENT=you@example.com

# Sender address. Defaults to the Resend sandbox (delivers only to your account email);
# set a verified domain to send anywhere.
VJA_DIGEST_FROM=onboarding@resend.dev

# Database URL. Defaults to local SQLite; swap to a Postgres URL at the hosted cutover (D-025).
VJA_DATABASE_URL=sqlite:///data/vja.db
