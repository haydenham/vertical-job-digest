# Copy to .env (git-ignored) and fill in. Loaded automatically by the app (python-dotenv);
# launchd does not read your shell, so .env is the single source of runtime config.

# Anthropic API key — required for Layer-2 LLM extraction (P5.2) + matching (P5.3).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# OpenAI API key — required only for the Layer-3 employer discovery agent.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Resend (transactional email) — required to send digests + failure alerts.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Digest recipient. With the sandbox sender below this MUST be your Resend account email.
VJA_DIGEST_RECIPIENT=you@example.com

# Sender address. Defaults to the Resend sandbox (delivers only to your account email);
# set a verified domain to send anywhere.
VJA_DIGEST_FROM=onboarding@resend.dev

# Database URL. Defaults to local SQLite; swap to a Postgres URL at the hosted cutover (D-025).
VJA_DATABASE_URL=sqlite:///data/vja.db

# --- Auth (Phase 9.2, D-055) ---
# Google OAuth client (Web application). Create at console.cloud.google.com → APIs & Services →
# Credentials, with authorized redirect URI http://localhost:8000/auth/callback (prod URI added in 9.5).
# Login routes are inert until both are set; the default test suite mocks the exchange (no creds needed).
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
# Signs the session cookie. Any long random string, e.g. `openssl rand -hex 32`.
VJA_SESSION_SECRET=change-me-to-a-long-random-string
# Enforcement seam: when "1"/"true", the read API requires a session (401 otherwise). Default off so the
# local dashboard stays usable before the login frontend (9.4) / deploy (9.5) flip it on.
VJA_AUTH_REQUIRED=0

# --- Résumé upload + signup backfill cost guards (Phase 9.3, D-057) ---
# Per-signup cap: most candidate postings a single backfill will LLM-match (bounds cost per signup).
VJA_BACKFILL_MAX_POSTINGS=100
# Global daily LLM-spend ceiling (USD). A signup backfill is refused (429) once the day's estimated
# spend reaches this (estimate = matches created today × a nominal ~$0.01/match; no per-match ledger).
VJA_DAILY_LLM_BUDGET_USD=5.0

# --- Deploy hardening (Phase 9.5a, D-059) — defaults are dev-safe; set these in prod (behind TLS) ---
# Session cookie Secure flag (HTTPS-only). Set "1" in prod; leave off for http://localhost dev.
VJA_COOKIE_SECURE=0
# Session lifetime in seconds (default 14 days = 1209600).
# VJA_SESSION_MAX_AGE=1209600
# Public origin of the deployed app — builds the OAuth callback as https://<base>/auth/callback (correct
# behind Cloud Run's TLS terminator, where url_for would yield http://). e.g. https://role-feed.com
# VJA_PUBLIC_BASE_URL=
# Bind host for `vja-api` (the container passes 0.0.0.0; Cloud Run also injects $PORT). Dev default 127.0.0.1.
# VJA_API_HOST=127.0.0.1
